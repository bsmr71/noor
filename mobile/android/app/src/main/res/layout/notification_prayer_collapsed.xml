<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_notif_container"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="10dp"
    android:paddingVertical="7dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/notif_collapsed_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Menuju Adzan Ashar (14:54 WIB)"
            android:textColor="#FFFFFF"
            android:textSize="12.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/notif_collapsed_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1.5dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="± 59 menit lagi • Wilayah Jakarta"
            android:textColor="#A7F3D0"
            android:textSize="10sp" />

        <ProgressBar
            android:id="@+id/notif_collapsed_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3.5dp"
            android:layout_marginTop="4dp"
            android:max="100"
            android:progress="65"
            android:progressDrawable="@drawable/notif_progress_custom" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_notif_box"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="7dp"
        android:paddingVertical="3dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="3dp"
            android:text="⏳"
            android:textSize="8sp" />

        <Chronometer
            android:id="@+id/notif_collapsed_chronometer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:countDown="true"
            android:textColor="#FE932C"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
